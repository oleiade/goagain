# Binaries
fab-api
fab-mcp
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Agents
.mcp.json
# Track this project's own skills; everything else under .claude/ is local,
# including settings and skills installed from elsewhere.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/release/
!.claude/skills/sync-data/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local development
.env
.env.local
.envrc

# Secrets / credentials — never commit these. Listed even though they should
# never live in the repo, because a developer dropping a local TLS cert or
# service-account key to test OTLP-over-TLS would otherwise commit it silently.
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
credentials.json
service-account*.json
